{
  "name": "stanandwill-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm --workspace apps/mobile run start",
    "test": "npm --workspace packages/core run test",
    "typecheck": "npm --workspace packages/core run typecheck && npm --workspace apps/mobile run typecheck",
    "test:emails": "npx --workspace packages/core vitest run --root ../.. supabase/functions/_shared/emails.test.ts"
  }
}
